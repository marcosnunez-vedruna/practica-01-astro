---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.astro';
---

<Layout title="Login">
	<main class="login-container">
        <LoginForm />
        <img src="/img_login.png" alt="login-banner" class="image" />
    </main>
</Layout>

<style>
  .login-container {
    display: flex;
    width: 100%;
    height: 100vh;
  }

  .image {
    width: 50%;
    height: 100vh;
    object-fit: cover;
    object-position: top;
  }
</style>