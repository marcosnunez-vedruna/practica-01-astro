---
import CategoryOption from '../components/CategoryOption.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Select">
	<main class="select-container">
        <CategoryOption
            title="Mujer"
            href="/woman"
            bgImage="/woman.png"
        />
        <CategoryOption
            title="Hombre"
            href="/man"
            bgImage="/man.png"
        />
    </main>
</Layout>

<style>
  .select-container {
    display: flex;
    width: 100%;
    height: 100vh;
  }
</style>